# Salin ke .env.local dan sesuaikan untuk development lokal.
# Backend API (tumbuh-be). Contoh lokal: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Workspace default pada layar login kasir (slug tenant hasil seed).
NEXT_PUBLIC_TENANT_SLUG=kopikita

# Turnstile: kosongkan untuk sembunyikan widget (dev tanpa captcha).
# Dev: NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA (test key)

# Error tracking (opsional — kosongkan untuk menonaktifkan Sentry).
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
